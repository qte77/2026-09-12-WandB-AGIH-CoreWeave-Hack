# Copy to .env and fill in real values. .env is gitignored — never commit real keys.
# One KEY=value per line — no trailing content on the same line as another var.

# wandb.ai → Settings → API keys (or https://wandb.ai/authorize)
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=coreweave-hacks-2026-09

# openrouter.ai → Keys. Model slug from https://openrouter.ai/models, e.g. anthropic/claude-sonnet-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
